{
  "manifest_version": 2,
  "name": "Email Assistant",
  "version": "1.0.9",
  "description": "Automatically tags messages base on AI rules",
  "permissions": [
    "messagesRead",
    "messagesUpdate",
    "accountsRead",
    "storage",
    "menus",
    "notifications",
    "messagesTags",
    "messagesTagsList",
    "http://localhost:11434/*",
    "http://193.198.194.108:11434/*"
  ],
  "optional_permissions": [
    "windows"
  ],
  "background": {
    "page": "background.html"
  },
  "options_ui": {
    "page": "options.html",
    "open_in_tab": true
  },
  "browser_specific_settings": {
    "gecko": {
      "id": "mail-assistant-0.1@entestat.com"
    }
  },
  "sidebar_action": {
    "default_panel": "progress.html"
  },
  "web_accessible_resources": [
    "progress.html",
    "progress.js",
    "progress.css"
  ]
}
